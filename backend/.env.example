# Only for running from source. PlanetRead.exe users enter their OpenAI key in
# the app's Settings dialog instead, which takes precedence over this file.
OPENAI_API_KEY=
# Only needed when models are downloaded from Hugging Face (no models/ folder).
HF_TOKEN=

# Optional settings
# Where uploads and results are stored. Relative paths are resolved next to the exe / project.
PLANETREAD_DATA_DIR=PlanetRead_data
PLANETREAD_MAX_UPLOAD_BYTES=2147483648
# Only used when running the Vite dev server separately.
PLANETREAD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
