# Copy this file to .env next to PlanetRead.exe (or in the project folder) and fill in the keys.
OPENAI_API_KEY=
HF_TOKEN=

# Optional settings
# Where uploads and results are stored. Relative paths are resolved next to the exe.
PLANETREAD_DATA_DIR=PlanetRead_data
PLANETREAD_MAX_UPLOAD_BYTES=2147483648
# Only used when running the Vite dev server separately.
PLANETREAD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
